[Global]
LookAndFeelSet=org.kde.klassydarkbottompanel.desktop

[TitleBarOpacity]
ActiveTitleBarOpacity=50
InactiveTitleBarOpacity=30
OpaqueMaximizedTitleBars=false
OverrideActiveTitleBarOpacity=true
OverrideInactiveTitleBarOpacity=true

[Windeco]
ActiveTitleBarOpacity=76
ButtonIconStyle=StyleArk
ButtonShape=ShapeSmallCircle
ButtonSpacingLeft=4
ButtonSpacingRight=6
InactiveTitleBarOpacity=58
MatchTitleBarToApplicationColor=true
ShadowSizeActive=ShadowLarge
ShadowStrengthActive=210
ShadowStrengthInactive=110
TitleBarBottomMargin=3
TitleBarTopMargin=3
WindowCornerRadius=10
WindowOutlineThickness=1

[WindowOutlineStyle]
WindowOutlineContrastOpacityActive=50
WindowOutlineOverlap=false
WindowOutlineStyleActive=WindowOutlineContrast
WindowOutlineStyleInactive=WindowOutlineContrast

