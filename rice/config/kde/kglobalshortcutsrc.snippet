# Sanitized extract from the live system. Merge these keys into [kwin]; do not replace the whole file.
[kwin]
Switch to Desktop 1=Alt+1,Ctrl+F1\tMeta+F1,Switch to Desktop 1
Switch to Desktop 2=Alt+2,Ctrl+F2\tMeta+F2,Switch to Desktop 2
Switch to Desktop 3=Alt+3,Ctrl+F3\tMeta+F3,Switch to Desktop 3
Switch to Desktop 4=Alt+4,Ctrl+F4\tMeta+F4,Switch to Desktop 4
Switch to Desktop 5=Alt+5,none,Switch to Desktop 5
Switch to Desktop 6=Alt+6,none,Switch to Desktop 6
Switch to Desktop 7=Alt+7,none,Switch to Desktop 7

